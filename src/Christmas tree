                    }
                 for(int j=1; j<=2*i-1; j++)
                    {
                        System.out.print("* ");
                    }
                System.out.println();
            }
        
        }

        static void pyramid3 () 
        {
            for(int i=1; i<=10; i++)
            {
                
                for(int j=10; j>=i; j--)
                    {
                        System.out.print("  ");
                    }
                 for(int j=1; j<=2*i-1; j++)
