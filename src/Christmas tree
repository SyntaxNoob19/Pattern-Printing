class Main {
    public static void main(String[] args) {
     pyramid1 ();
     pyramid2 ();
     pyramid3 ();
     trunk();
    }
    

    static void pyramid1 ()
        {

            for(int i=1; i<=6; i++)
            {
                 for(int j=1 ;j<=4; j++)
                  {
                        System.out.print("  ");
                   }                
                for(int j=6; j>=i; j--)
                    {
                        System.out.print("  ");
                    }
                 for(int j=1; j<=2*i-1; j++)
                    {
                        System.out.print("* ");
                    }
                System.out.println();
            }
        }


   static  void pyramid2 () 
        {
