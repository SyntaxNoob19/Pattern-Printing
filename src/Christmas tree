        }

       static  void trunk()
            {
                for(int i=1; i<=4; i++)
                    {
                        for(int j=1 ;j<=7; j++)
                            {
                                System.out.print("  ");
                            }
                    
                        for(int j=7 ;j<=13; j++)
                            {
                                System.out.print("* ");
                            }
                        System.out.println();
                    }
            }

        
    
}
